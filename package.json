{
  "name": "commercebill",
  "version": "0.1.0",
  "private": true,
  "description": "CommerceBill Desktop - local-first billing, inventory, accounting and e-commerce order management (monorepo root)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "db:start": "tsx scripts/db-start.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx prisma/seed/seed.ts",
    "db:validate": "prisma validate",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run --project unit --project integration",
    "test:release": "vitest run --project release",
    "verify:release": "tsx scripts/verify-release.ts",
    "build": "npm run build --workspaces --if-present",
    "verify:phase0": "tsx scripts/verify-phase0.ts",
    "package:win": "tsx scripts/package-win.ts",
    "bench:password-hash": "tsx scripts/benchmark-password-hash.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "electron-builder": "^26.15.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2"
  }
}
