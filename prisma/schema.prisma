// CommerceBill Desktop - Prisma schema (Phase 0 foundation).
//
// Scope: Foundation tables from master spec section 34 only. Master data, inventory,
// sales, purchasing, accounting, reconciliation and integration tables are added by the
// phases that own them (see docs/DATABASE_SCHEMA.md for the full domain map).
//
// Conventions (docs/DATABASE_CONVENTIONS.md):
//  - Table/column names are snake_case via @@map/@map; model names are PascalCase.
//  - Primary keys are UUIDs generated by the database (gen_random_uuid()).
//  - Every business table carries organization_id (multi-organization ready).
//  - Money is Decimal(18,2); rates are Decimal(7,4); quantities are Decimal(18,4).
//  - Timestamps are timestamptz. `version` supports optimistic concurrency.
//  - Posted financial records are never hard-deleted; configuration rows use `isActive`.

generator client {
  provider = "prisma-client"
  output   = "../packages/database/src/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organization
// ---------------------------------------------------------------------------

enum GstRegistrationStatus {
  REGISTERED
  UNREGISTERED
  COMPOSITION
}

model Organization {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalName        String                @map("legal_name")
  tradeName        String?               @map("trade_name")
  businessType     String?               @map("business_type")
  pan              String?               @db.VarChar(10)
  gstStatus        GstRegistrationStatus @default(UNREGISTERED) @map("gst_status")
  gstin            String?               @db.VarChar(15)
  stateCode        String?               @map("state_code") @db.VarChar(2)
  country          String                @default("IN") @db.VarChar(2)
  baseCurrency     String                @default("INR") @map("base_currency") @db.VarChar(3)
  setupCompletedAt DateTime?             @map("setup_completed_at") @db.Timestamptz(6)
  setupStep        Int                   @default(0) @map("setup_step")
  isDemoData       Boolean               @default(false) @map("is_demo_data")
  isActive         Boolean               @default(true) @map("is_active")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int                   @default(1)

  settings                  OrganizationSetting[]
  locations                 BusinessLocation[]
  financialYears            FinancialYear[]
  warehouses                Warehouse[]
  customers                 Customer[]
  customerCodeCounter       CustomerCodeCounter?
  products                  Product[]
  productCodeCounter        ProductCodeCounter?
  stockMovements            StockMovement[]
  stockBalances             StockBalance[]
  hsnSacCodes               HsnSacCode[]
  salesInvoices             SalesInvoice[]
  payments                  Payment[]
  backupRecords             BackupRecord[]
  backupVerifications       BackupVerification[]
  paymentAllocations        PaymentAllocation[]
  taxConfigurationReviews   TaxConfigurationReview[]
  users                     User[]
  roles                     Role[]
  documentSequences         DocumentSequence[]
  documentNumberAllocations DocumentNumberAllocation[]
  taxCategories             TaxCategory[]
  taxRates                  TaxRate[]
  units                     Unit[]
  auditLogs                 AuditLog[]
  applicationSettings       ApplicationSetting[]

  @@map("organizations")
}

/// Key/value business settings (branding, rounding, date format, ...). Typed in the service layer.
model OrganizationSetting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  value          Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("organization_settings")
}

model BusinessLocation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  addressLine1   String   @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String?
  state          String?
  stateCode      String?  @map("state_code") @db.VarChar(2)
  country        String   @default("IN") @db.VarChar(2)
  pinCode        String?  @map("pin_code") @db.VarChar(10)
  gstin          String?  @db.VarChar(15)
  isPrimary      Boolean  @default(false) @map("is_primary")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouses    Warehouse[]
  sequences     DocumentSequence[]
  salesInvoices SalesInvoice[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("business_locations")
}

model FinancialYear {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Display label such as "2026-27".
  label          String
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  isLocked       Boolean   @default(false) @map("is_locked")
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sequences     DocumentSequence[]
  salesInvoices SalesInvoice[]
  payments      Payment[]

  @@unique([organizationId, label])
  @@index([organizationId, startDate, endDate])
  @@map("financial_years")
}

model Warehouse {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid
  code           String
  name           String
  isPrimary      Boolean  @default(false) @map("is_primary")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location       BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]
  stockBalances  StockBalance[]
  salesInvoices  SalesInvoice[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("warehouses")
}

// ---------------------------------------------------------------------------
// Identity and access (behaviour arrives in Phase 1; tables are the foundation)
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  username           String
  displayName        String    @map("display_name")
  email              String?
  /// Argon2id hash (encoded form). Never plaintext. Never logged.
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  isDemoUser         Boolean   @default(false) @map("is_demo_user")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int       @default(1)

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles             UserRole[]
  sessions          Session[]
  auditLogs         AuditLog[]
  stockMovements    StockMovement[]
  hsnSacReviews     HsnSacCode[]             @relation("HsnSacReviewer")
  taxReviews        TaxConfigurationReview[] @relation("TaxReviewer")
  invoicesCreated   SalesInvoice[]           @relation("InvoiceCreator")
  invoicesConfirmed SalesInvoice[]           @relation("InvoicePosConfirmer")
  paymentsCreated   Payment[]                @relation("PaymentCreator")
  backupsCreated    BackupRecord[]           @relation("BackupCreator")
  backupsVerified   BackupVerification[]     @relation("BackupVerifier")

  @@unique([organizationId, username])
  @@index([organizationId])
  @@map("users")
}

model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  /// True for the five predefined role templates (spec section 11); system roles cannot be deleted.
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([organizationId, name])
  @@map("roles")
}

/// Global permission catalogue (not organization scoped): permissions are defined by the application.
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable machine key such as "sales.invoice.post".
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque session token; the token itself is never stored.
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Numbering and tax configuration
// ---------------------------------------------------------------------------

/// Transactional document-number counter. Allocation (Phase 1) must happen in the same
/// transaction that posts the document; `lastNumber` is advanced under a row lock.
model DocumentSequence {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  locationId      String?  @map("location_id") @db.Uuid
  financialYearId String   @map("financial_year_id") @db.Uuid
  documentType    String   @map("document_type")
  prefix          String   @default("")
  suffix          String   @default("")
  numericLength   Int      @default(6) @map("numeric_length")
  startNumber     BigInt   @default(1) @map("start_number")
  /// FINANCIAL_YEAR: a new financial year's sequence restarts at 1. NEVER: it continues after the previous number.
  resetPolicy     String   @default("FINANCIAL_YEAR") @map("reset_policy")
  /// Inactive sequences keep their history but cannot allocate. Sequences are never deleted.
  isActive        Boolean  @default(true) @map("is_active")
  /// Highest number allocated so far (0 = none). Numbers are never reused.
  lastNumber      BigInt   @default(0) @map("last_number")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1)

  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location      BusinessLocation?          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  financialYear FinancialYear              @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  allocations   DocumentNumberAllocation[]

  // NOTE: PostgreSQL treats NULLs as distinct; a partial unique index in the migration
  // covers the (location IS NULL) case.
  @@unique([organizationId, locationId, financialYearId, documentType])
  @@index([organizationId])
  @@map("document_sequences")
}

/// Append-only ledger of every permanent document number ever issued. It is the record that a number was used (and
/// for which document), makes allocation idempotent per document, and keeps formatted numbers immutable even if the
/// sequence configuration (prefix, width) changes later. UPDATE and DELETE are blocked by triggers.
model DocumentNumberAllocation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  sequenceId      String   @map("sequence_id") @db.Uuid
  /// Stable machine code, e.g. INVOICE (denormalised from the sequence for the uniqueness rules below).
  documentType    String   @map("document_type")
  /// The raw counter value that was issued.
  sequenceNumber  BigInt   @map("sequence_number")
  /// The number exactly as printed on the document, frozen at allocation time.
  formattedNumber String   @map("formatted_number")
  /// Identity of the document being posted (its internal id). Re-requesting the same document returns the same number.
  documentRef     String   @map("document_ref")
  allocatedAt     DateTime @default(now()) @map("allocated_at") @db.Timestamptz(6)
  correlationId   String?  @map("correlation_id")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sequence     DocumentSequence @relation(fields: [sequenceId], references: [id], onDelete: Restrict)

  @@unique([sequenceId, sequenceNumber])
  @@unique([organizationId, documentType, formattedNumber])
  @@unique([organizationId, documentType, documentRef])
  @@index([organizationId, allocatedAt])
  @@map("document_number_allocations")
}

model TaxCategory {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  /// STANDARD, NIL_RATED, EXEMPT, ZERO_RATED, NON_GST (classification, not a rate).
  classification String
  isActive       Boolean   @default(true) @map("is_active")
  /// Date from which the category may be used; NULL = always. Effective dating of values lives on tax_rates.
  effectiveFrom  DateTime? @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  /// USER (entered by a person) or REFERENCE_SEED (installed by the reference seed).
  origin         String    @default("USER")
  /// UNREVIEWED until an authorized accountant/tax professional has confirmed the values.
  reviewStatus   String    @default("UNREVIEWED") @map("review_status")
  reviewNote     String?   @map("review_note")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rates             TaxRate[]
  products          Product[]
  salesInvoiceLines SalesInvoiceLine[]

  @@unique([organizationId, code])
  @@map("tax_categories")
}

/// Effective-dated tax rates. Rows are append-only in spirit: a rate change inserts a new
/// row with a new effectiveFrom and closes the old one; posted documents keep snapshots.
model TaxRate {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  /// Total GST rate in percent (e.g. 18.0000). CGST/SGST split is derived by the tax engine.
  ratePercent    Decimal   @map("rate_percent") @db.Decimal(7, 4)
  cessPercent    Decimal   @default(0) @map("cess_percent") @db.Decimal(7, 4)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  /// USER (entered by a person) or REFERENCE_SEED (installed by the reference seed).
  origin         String    @default("USER")
  /// UNREVIEWED until an authorized accountant/tax professional has confirmed the values.
  reviewStatus   String    @default("UNREVIEWED") @map("review_status")
  reviewNote     String?   @map("review_note")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category          TaxCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  salesInvoiceLines SalesInvoiceLine[]

  @@unique([categoryId, effectiveFrom])
  @@index([organizationId, effectiveFrom])
  @@map("tax_rates")
}

/// Organization-scoped HSN/SAC list, maintained by the user (Task 1.12, ADR-0023). No official data is bundled or invented:
/// every row is entered by a person (origin USER; IMPORT is reserved for a later reviewed import) and starts UNREVIEWED.
/// `code` and `kind` never change after creation; rows are never deleted (made inactive).
model HsnSacCode {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String    @db.VarChar(8)
  /// "HSN" (goods) or "SAC" (services).
  kind           String    @db.VarChar(3)
  description    String?
  isActive       Boolean   @default(true) @map("is_active")
  origin         String    @default("USER")
  reviewStatus   String    @default("UNREVIEWED") @map("review_status")
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reviewer     User?        @relation("HsnSacReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, code])
  @@index([organizationId, kind])
  @@map("hsn_sac_codes")
}

/// One confirmation of the tax configuration by a person (Task 1.12, ADR-0023). Append-only (triggers refuse UPDATE,
/// DELETE and TRUNCATE). It is a business/professional confirmation recorded by CommerceBill, NOT government verification or
/// legal certification. A review applies to exactly one configuration fingerprint; when the fingerprint changes the latest
/// review is stale.
model TaxConfigurationReview {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId             String   @map("organization_id") @db.Uuid
  fingerprint                String
  reviewedBy                 String   @map("reviewed_by") @db.Uuid
  /// The reviewer's own statement of the capacity in which they confirm (free text).
  reviewerCapacity           String   @map("reviewer_capacity")
  reviewedAt                 DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  noticeVersion              String   @map("notice_version")
  noticeText                 String   @map("notice_text")
  note                       String?
  engineVersion              String   @map("engine_version")
  rulesetVersion             String   @map("ruleset_version")
  jurisdictionRulesetVersion String   @map("jurisdiction_ruleset_version")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reviewer      User           @relation("TaxReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  salesInvoices SalesInvoice[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("tax_configuration_reviews")
}

model Unit {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  decimalPlaces  Int      @default(0) @map("decimal_places")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, code])
  @@map("units")
}

// ---------------------------------------------------------------------------
// Customers (Task 1.9)
// ---------------------------------------------------------------------------

/// A customer of one organization. The primary key is an internal UUID; `code` is the stable, human-facing
/// identifier shown on screens and documents (unique per organization, immutable once created). Customers are
/// never deleted (posted documents will reference them): they are made inactive. State is stored as the two-digit
/// GST state code only (the name is derived from the reference list); `placeOfSupplyStateCode` is a stored FACT that
/// the Task 1.12 tax engine reads - this table makes no tax decision.
model Customer {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                @map("organization_id") @db.Uuid
  code                   String
  /// BUSINESS or INDIVIDUAL: what kind of party this is. It is independent of GST registration (ADR-0023): the invoice
  /// derives B2B/B2C per document from the recipient GST facts.
  customerKind           String                @map("customer_kind")
  legalName              String                @map("legal_name")
  displayName            String?               @map("display_name")
  contactPerson          String?               @map("contact_person")
  email                  String?
  phone                  String?
  alternatePhone         String?               @map("alternate_phone")
  gstStatus              GstRegistrationStatus @default(UNREGISTERED) @map("gst_status")
  gstin                  String?               @db.VarChar(15)
  pan                    String?               @db.VarChar(10)
  billingAddressLine1    String                @map("billing_address_line1")
  billingAddressLine2    String?               @map("billing_address_line2")
  billingCity            String?               @map("billing_city")
  billingStateCode       String                @map("billing_state_code") @db.VarChar(2)
  billingPinCode         String?               @map("billing_pin_code") @db.VarChar(6)
  country                String                @default("IN") @db.VarChar(2)
  /// When true the shipping_* columns are NULL and the billing address is used for delivery.
  shippingSameAsBilling  Boolean               @default(true) @map("shipping_same_as_billing")
  shippingAddressLine1   String?               @map("shipping_address_line1")
  shippingAddressLine2   String?               @map("shipping_address_line2")
  shippingCity           String?               @map("shipping_city")
  shippingStateCode      String?               @map("shipping_state_code") @db.VarChar(2)
  shippingPinCode        String?               @map("shipping_pin_code") @db.VarChar(6)
  placeOfSupplyStateCode String                @map("place_of_supply_state_code") @db.VarChar(2)
  creditLimit            Decimal?              @map("credit_limit") @db.Decimal(14, 2)
  paymentTermsDays       Int?                  @map("payment_terms_days")
  notes                  String?
  isActive               Boolean               @default(true) @map("is_active")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                Int                   @default(1)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesInvoices SalesInvoice[]
  payments      Payment[]

  // The GSTIN uniqueness (partial: only where a GSTIN exists) is a partial unique index in the migration.
  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([organizationId, legalName])
  @@map("customers")
}

/// Per-organization counter behind generated customer codes (CUS-000001, ...). Advanced under a row lock inside the
/// creating transaction, so a rolled-back creation gives its number back and concurrent creations cannot collide.
model CustomerCodeCounter {
  organizationId String   @id @map("organization_id") @db.Uuid
  lastNumber     BigInt   @default(0) @map("last_number")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("customer_code_counters")
}

// ---------------------------------------------------------------------------
// Products (Task 1.10)
// ---------------------------------------------------------------------------

/// A sellable item of one organization. `id` is the stable identity that invoice lines and stock movements will
/// reference (see ADR-0021 for how variants can be added later without touching posted history). `sku` is the
/// human-facing code: unique per organization, immutable once created. `kind` (GOODS or SERVICE) is immutable too.
/// Products are never deleted - they are made inactive. The row stores tax CONFIGURATION (HSN/SAC and a tax-category
/// reference) only; no rate is copied here and no tax is calculated here (Task 1.12). There is no quantity column:
/// the Task 1.11 stock ledger will be the only source of stock truth.
model Product {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  sku              String
  name             String
  description      String?
  kind             String
  hsnSacCodeId     String?  @map("hsn_sac_code_id") @db.Uuid
  unitId           String?  @map("unit_id") @db.Uuid
  taxCategoryId    String   @map("tax_category_id") @db.Uuid
  mrp              Decimal? @db.Decimal(18, 2)
  sellingPrice     Decimal  @map("selling_price") @db.Decimal(18, 2)
  /// true: the selling price already includes GST; false: GST is added on top. Display/config only.
  priceIncludesTax Boolean  @default(false) @map("price_includes_tax")
  /// Only GOODS may track inventory (CHECK). Whether stock exists is the Task 1.11 ledger's business.
  trackInventory   Boolean  @default(false) @map("track_inventory")
  barcode          String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int      @default(1)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  hsnSacCode        HsnSacCode?        @relation(fields: [hsnSacCodeId], references: [id], onDelete: Restrict)
  unit              Unit?              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  taxCategory       TaxCategory        @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)
  stockMovements    StockMovement[]
  stockBalances     StockBalance[]
  salesInvoiceLines SalesInvoiceLine[]

  // A barcode is unique per organization when present (partial unique index in the migration).
  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
  @@index([organizationId, name])
  @@map("products")
}

/// Per-organization counter behind generated SKUs (PRD-000001, ...), advanced under a row lock in the creating transaction.
model ProductCodeCounter {
  organizationId String   @id @map("organization_id") @db.Uuid
  lastNumber     BigInt   @default(0) @map("last_number")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("product_code_counters")
}

// ---------------------------------------------------------------------------
// Inventory (Task 1.11, ADR-0022)
// ---------------------------------------------------------------------------

/// The append-only stock ledger: the ONLY source of stock truth (physical QUANTITY only - no cost or value). One row per
/// physical change, with a signed `quantityDelta` (numeric(18,4), exact; never a JavaScript number). Rows are immutable:
/// database triggers refuse UPDATE, DELETE and TRUNCATE, so a correction is a new compensating row. `movementType` is a
/// text column guarded by a CHECK so later tasks widen the list in a migration (sales dispatch, returns, transfers...).
/// `(organizationId, sourceType, sourceRef, sourceLineRef)` is the idempotency identity: the same logical event can never
/// post twice. Manual operations use sourceType MANUAL with the client's operation id as sourceRef.
model StockMovement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  /// The sellable-item identity (ADR-0021).
  productId      String   @map("product_id") @db.Uuid
  movementType   String   @map("movement_type")
  quantityDelta  Decimal  @map("quantity_delta") @db.Decimal(18, 4)
  /// The business date of the stock event (the day it physically happened).
  businessDate   DateTime @map("business_date") @db.Date
  sourceType     String   @map("source_type")
  sourceRef      String   @map("source_ref")
  sourceLineRef  String   @default("") @map("source_line_ref")
  /// Adjustments only: COUNT_CORRECTION | FOUND | DAMAGE | LOSS | OTHER.
  reasonCode     String?  @map("reason_code")
  /// Free-text document reference (for example a delivery challan number). Never written to audit rows or logs.
  reference      String?
  note           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String   @map("created_by") @db.Uuid

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdByUser User         @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([organizationId, sourceType, sourceRef, sourceLineRef])
  @@index([organizationId, productId, createdAt(sort: Desc)])
  @@index([organizationId, warehouseId, productId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

/// Stock on hand per (warehouse, product): a PROJECTION of the ledger, maintained by a database trigger in the same
/// statement as the movement insert, under that row's lock. It is never written by the application directly (a trigger
/// refuses any write that does not come from the ledger trigger) and can be reconciled against the ledger at any time.
/// CHECK quantity_on_hand >= 0 is the no-negative-stock policy (a later setting may relax it by migration).
model StockBalance {
  organizationId String   @map("organization_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  quantityOnHand Decimal  @map("quantity_on_hand") @db.Decimal(18, 4)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([warehouseId, productId])
  @@index([organizationId, productId])
  @@map("stock_balances")
}

// ---------------------------------------------------------------------------
// Sales invoices (Task 1.13, ADR-0024)
// ---------------------------------------------------------------------------

/// A POSTED sales invoice (there are no persisted drafts in Task 1.13). Immutable from its first INSERT: triggers refuse UPDATE,
/// DELETE and TRUNCATE. Everything printed or reported comes from these snapshot columns and the stored tax calculation, never
/// from the mutable customer/product/tax masters. `isDemo` invoices use the DEMO_INVOICE number series, never touch the stock
/// ledger and are never production documents. A production invoice receivable is derived later (grand_total minus payment
/// allocations, Task 1.16); no receivable is stored here.
model SalesInvoice {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  status             String   @default("POSTED")
  /// The client idempotency identity of the posting; one successful post per organization.
  postOperationId    String   @map("post_operation_id") @db.Uuid
  /// SHA-256 of the canonical request, so a retry with different content is refused.
  requestFingerprint String   @map("request_fingerprint")
  /// INVOICE (production) or DEMO_INVOICE.
  documentType       String   @map("document_type")
  documentNumber     String   @map("document_number")
  isDemo             Boolean  @map("is_demo")
  invoiceDate        DateTime @map("invoice_date") @db.Date
  financialYearId    String   @map("financial_year_id") @db.Uuid
  financialYearLabel String   @map("financial_year_label")
  currency           String   @default("INR") @db.VarChar(3)
  locationId         String   @map("location_id") @db.Uuid
  warehouseId        String   @map("warehouse_id") @db.Uuid
  warehouseName      String   @map("warehouse_name")

  sellerLegalName    String  @map("seller_legal_name")
  sellerTradeName    String? @map("seller_trade_name")
  sellerGstin        String  @map("seller_gstin") @db.VarChar(15)
  sellerGstStatus    String  @map("seller_gst_status")
  sellerStateCode    String  @map("seller_state_code") @db.VarChar(2)
  sellerAddressLine1 String  @map("seller_address_line1")
  sellerAddressLine2 String? @map("seller_address_line2")
  sellerCity         String? @map("seller_city")
  sellerPinCode      String? @map("seller_pin_code")

  customerId           String  @map("customer_id") @db.Uuid
  customerCode         String  @map("customer_code")
  customerName         String  @map("customer_name")
  customerGstStatus    String  @map("customer_gst_status")
  customerGstin        String? @map("customer_gstin") @db.VarChar(15)
  billingAddressLine1  String  @map("billing_address_line1")
  billingAddressLine2  String? @map("billing_address_line2")
  billingCity          String? @map("billing_city")
  billingStateCode     String  @map("billing_state_code") @db.VarChar(2)
  billingPinCode       String? @map("billing_pin_code")
  /// The delivery address as it was when the invoice was posted (a copy of billing when delivery was the same).
  shippingAddressLine1 String  @map("shipping_address_line1")
  shippingAddressLine2 String? @map("shipping_address_line2")
  shippingCity         String? @map("shipping_city")
  shippingStateCode    String  @map("shipping_state_code") @db.VarChar(2)
  shippingPinCode      String? @map("shipping_pin_code")
  /// B2B exactly when a recipient GSTIN was supplied (derived by the tax engine for THIS document).
  recipientClass       String  @map("recipient_class")

  posStateCode   String   @map("pos_state_code") @db.VarChar(2)
  /// USER_CONFIRMED or USER_OVERRIDE (a mere suggestion is never postable).
  posSource      String   @map("pos_source")
  posConfirmedBy String   @map("pos_confirmed_by") @db.Uuid
  posConfirmedAt DateTime @map("pos_confirmed_at") @db.Timestamptz(6)

  priceBasis                  String  @map("price_basis")
  engineVersion               String  @map("engine_version")
  rulesetVersion              String  @map("ruleset_version")
  roundingPolicyId            String  @map("rounding_policy_id")
  taxInputHash                String  @map("tax_input_hash")
  taxConfigurationFingerprint String  @map("tax_configuration_fingerprint")
  /// The review that was current when a PRODUCTION invoice was posted (required for production, null for demo).
  taxReviewId                 String? @map("tax_review_id") @db.Uuid
  /// The complete TaxEngine result (lines, totals, explanations, warnings) that produced the numbers below.
  taxCalculation              Json    @map("tax_calculation")

  grossSubtotal           Decimal @map("gross_subtotal") @db.Decimal(18, 2)
  lineDiscountTotal       Decimal @map("line_discount_total") @db.Decimal(18, 2)
  taxableSubtotal         Decimal @map("taxable_subtotal") @db.Decimal(18, 2)
  cgstTotal               Decimal @map("cgst_total") @db.Decimal(18, 2)
  sgstTotal               Decimal @map("sgst_total") @db.Decimal(18, 2)
  utgstTotal              Decimal @map("utgst_total") @db.Decimal(18, 2)
  igstTotal               Decimal @map("igst_total") @db.Decimal(18, 2)
  roundingAdjustmentTotal Decimal @map("rounding_adjustment_total") @db.Decimal(18, 2)
  roundOff                Decimal @map("round_off") @db.Decimal(18, 2)
  grandTotal              Decimal @map("grand_total") @db.Decimal(18, 2)

  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  correlationId String?  @map("correlation_id")

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  financialYear FinancialYear           @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  location      BusinessLocation        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  warehouse     Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  customer      Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdByUser User                    @relation("InvoiceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  posConfirmer  User                    @relation("InvoicePosConfirmer", fields: [posConfirmedBy], references: [id], onDelete: Restrict)
  taxReview     TaxConfigurationReview? @relation(fields: [taxReviewId], references: [id], onDelete: Restrict)
  lines         SalesInvoiceLine[]
  allocations   PaymentAllocation[]

  @@unique([organizationId, postOperationId])
  @@unique([organizationId, documentType, documentNumber])
  @@unique([id, organizationId])
  @@index([organizationId, invoiceDate(sort: Desc)])
  @@index([organizationId, customerId])
  @@map("sales_invoices")
}

/// One line of a posted invoice: every printed fact is a snapshot; the product, tax category and rate keys are kept for traceability only.
model SalesInvoiceLine {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId          String    @map("invoice_id") @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  lineNo             Int       @map("line_no")
  productId          String    @map("product_id") @db.Uuid
  sku                String
  productName        String    @map("product_name")
  itemKind           String    @map("item_kind")
  hsnSacCode         String?   @map("hsn_sac_code") @db.VarChar(8)
  hsnSacKind         String?   @map("hsn_sac_kind") @db.VarChar(3)
  unitCode           String    @map("unit_code")
  unitName           String    @map("unit_name")
  taxCategoryId      String    @map("tax_category_id") @db.Uuid
  taxCategoryCode    String    @map("tax_category_code")
  taxCategoryName    String    @map("tax_category_name")
  classification     String
  taxRateId          String    @map("tax_rate_id") @db.Uuid
  ratePercent        Decimal   @map("rate_percent") @db.Decimal(7, 4)
  rateEffectiveFrom  DateTime  @map("rate_effective_from") @db.Date
  rateEffectiveTo    DateTime? @map("rate_effective_to") @db.Date
  quantity           Decimal   @db.Decimal(18, 4)
  unitPrice          Decimal   @map("unit_price") @db.Decimal(18, 2)
  priceBasis         String    @map("price_basis")
  grossAmount        Decimal   @map("gross_amount") @db.Decimal(18, 2)
  discountType       String    @map("discount_type")
  discountPercent    Decimal?  @map("discount_percent") @db.Decimal(7, 4)
  discountAmount     Decimal   @map("discount_amount") @db.Decimal(18, 2)
  taxableValue       Decimal   @map("taxable_value") @db.Decimal(18, 2)
  cgstRate           Decimal?  @map("cgst_rate") @db.Decimal(8, 5)
  cgstAmount         Decimal   @default(0) @map("cgst_amount") @db.Decimal(18, 2)
  sgstRate           Decimal?  @map("sgst_rate") @db.Decimal(8, 5)
  sgstAmount         Decimal   @default(0) @map("sgst_amount") @db.Decimal(18, 2)
  utgstRate          Decimal?  @map("utgst_rate") @db.Decimal(8, 5)
  utgstAmount        Decimal   @default(0) @map("utgst_amount") @db.Decimal(18, 2)
  igstRate           Decimal?  @map("igst_rate") @db.Decimal(8, 5)
  igstAmount         Decimal   @default(0) @map("igst_amount") @db.Decimal(18, 2)
  roundingAdjustment Decimal   @default(0) @map("rounding_adjustment") @db.Decimal(18, 2)
  lineTotal          Decimal   @map("line_total") @db.Decimal(18, 2)
  /// DISPATCH (a matching SALES_DISPATCH movement exists) or NONE (untracked goods, and EVERY line of a demo invoice).
  stockEffect        String    @map("stock_effect")

  invoice     SalesInvoice @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  taxCategory TaxCategory  @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)
  taxRate     TaxRate      @relation(fields: [taxRateId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, lineNo])
  @@index([organizationId, productId])
  @@map("sales_invoice_lines")
}

// ---------------------------------------------------------------------------
// System
// ---------------------------------------------------------------------------

/// Append-only business audit log. UPDATE and DELETE are blocked by database triggers
/// (see the foundation migration). Secrets must be redacted before insertion.
model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  userId         String?  @map("user_id") @db.Uuid
  category       String
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  beforeValues   Json?    @map("before_values")
  afterValues    Json?    @map("after_values")
  reason         String?
  appVersion     String   @map("app_version")
  deviceId       String?  @map("device_id")
  correlationId  String?  @map("correlation_id")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([entityType, entityId])
  @@index([userId, occurredAt])
  @@map("audit_logs")
}

/// Application-level settings (schema version markers, feature flags). Organization optional.
model ApplicationSetting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  value          Json
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("application_settings")
}

/// A customer payment (Task 1.16). Append-only: UPDATE, DELETE and TRUNCATE are refused by triggers; a correction is a future
/// reversal entry. A DEMO payment (is_demo) is NOT money received: it can only be allocated to a demo invoice and never enters
/// production receivables. Always fully allocated at creation (the allocations sum to the amount).
model Payment {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  customerId         String   @map("customer_id") @db.Uuid
  /// PAYMENT_RECEIPT (production) or DEMO_PAYMENT_RECEIPT.
  documentType       String   @map("document_type")
  paymentNumber      String   @map("payment_number")
  isDemo             Boolean  @map("is_demo")
  status             String   @default("RECORDED")
  paymentDate        DateTime @map("payment_date") @db.Date
  amount             Decimal  @db.Decimal(18, 2)
  /// CASH | BANK_TRANSFER | UPI | CARD | CHEQUE | OTHER. Never card numbers, PINs or credentials.
  method             String
  reference          String?
  notes              String?
  financialYearId    String   @map("financial_year_id") @db.Uuid
  /// The client idempotency identity; one payment per organization and operation.
  postOperationId    String   @map("post_operation_id") @db.Uuid
  requestFingerprint String   @map("request_fingerprint")
  createdBy          String   @map("created_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  correlationId      String?  @map("correlation_id")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  financialYear FinancialYear       @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  creator       User                @relation("PaymentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  allocations   PaymentAllocation[]

  @@unique([organizationId, postOperationId])
  @@unique([organizationId, documentType, paymentNumber])
  @@unique([id, organizationId])
  @@index([organizationId, paymentDate(sort: Desc)])
  @@index([organizationId, customerId])
  @@map("payments")
}

/// Appends an amount of one payment to one invoice. The balance of an invoice is its immutable grand total minus the sum of
/// its allocations: there is no stored balance anywhere.
model PaymentAllocation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  isDemo         Boolean  @map("is_demo")
  amount         Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  invoice      SalesInvoice @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([organizationId, invoiceId])
  @@map("payment_allocations")
}

/// One created backup file (Task 1.17). Append-only, except that file_deleted_at can be set once (retention). The passphrase is
/// never stored. `file_name` is the display name only; the destination folder is registered by the desktop shell, never sent by a client.
model BackupRecord {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Strictly increasing creation order (independent of any clock).
  seq              BigInt    @unique @default(autoincrement())
  organizationId   String    @map("organization_id") @db.Uuid
  /// MANUAL | PRE_RESTORE
  kind             String
  fileName         String    @map("file_name")
  destinationLabel String?   @map("destination_label")
  sizeBytes        BigInt    @map("size_bytes")
  appVersion       String    @map("app_version")
  schemaVersion    String    @map("schema_version")
  backupFormat     Int       @map("backup_format")
  /// Identity of the database the backup came from (see the recovery policy in ADR-0027).
  databaseId       String    @map("database_id") @db.Uuid
  /// SHA-256 of the manifest content: the fingerprint of the backup.
  manifestSha256   String    @map("manifest_sha256")
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  correlationId    String?   @map("correlation_id")
  fileDeletedAt    DateTime? @map("file_deleted_at") @db.Timestamptz(6)

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator       User?                @relation("BackupCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  verifications BackupVerification[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("backup_records")
}

/// The outcome of one verified-restore run of a backup: decrypted, checked and restored into an isolated database, then reconciled.
/// Append-only. The production gate reads the latest one (ADR-0027).
model BackupVerification {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Strictly increasing: the order of verifications (the latest one decides the production gate), independent of any clock.
  seq            BigInt   @unique @default(autoincrement())
  organizationId String   @map("organization_id") @db.Uuid
  backupId       String   @map("backup_id") @db.Uuid
  /// PASS | FAIL
  result         String
  engineVersion  String   @map("engine_version")
  schemaVersion  String   @map("schema_version")
  databaseId     String   @map("database_id") @db.Uuid
  verifiedAt     DateTime @default(now()) @map("verified_at") @db.Timestamptz(6)
  /// Named checks with pass/fail and counts only: never row data, passphrases or paths.
  details        Json
  verifiedBy     String?  @map("verified_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  backup       BackupRecord @relation(fields: [backupId, organizationId], references: [id, organizationId], onDelete: Restrict)
  verifier     User?        @relation("BackupVerifier", fields: [verifiedBy], references: [id], onDelete: Restrict)

  @@index([organizationId, verifiedAt(sort: Desc)])
  @@map("backup_verifications")
}
