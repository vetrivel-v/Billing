// CommerceBill Desktop - Prisma schema (Phase 0 foundation).
//
// Scope: Foundation tables from master spec section 34 only. Master data, inventory,
// sales, purchasing, accounting, reconciliation and integration tables are added by the
// phases that own them (see docs/DATABASE_SCHEMA.md for the full domain map).
//
// Conventions (docs/DATABASE_CONVENTIONS.md):
//  - Table/column names are snake_case via @@map/@map; model names are PascalCase.
//  - Primary keys are UUIDs generated by the database (gen_random_uuid()).
//  - Every business table carries organization_id (multi-organization ready).
//  - Money is Decimal(18,2); rates are Decimal(7,4); quantities are Decimal(18,4).
//  - Timestamps are timestamptz. `version` supports optimistic concurrency.
//  - Posted financial records are never hard-deleted; configuration rows use `isActive`.

generator client {
  provider = "prisma-client"
  output   = "../packages/database/src/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organization
// ---------------------------------------------------------------------------

enum GstRegistrationStatus {
  REGISTERED
  UNREGISTERED
  COMPOSITION
}

model Organization {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalName        String                @map("legal_name")
  tradeName        String?               @map("trade_name")
  businessType     String?               @map("business_type")
  pan              String?               @db.VarChar(10)
  gstStatus        GstRegistrationStatus @default(UNREGISTERED) @map("gst_status")
  gstin            String?               @db.VarChar(15)
  stateCode        String?               @map("state_code") @db.VarChar(2)
  country          String                @default("IN") @db.VarChar(2)
  baseCurrency     String                @default("INR") @map("base_currency") @db.VarChar(3)
  setupCompletedAt DateTime?             @map("setup_completed_at") @db.Timestamptz(6)
  setupStep        Int                   @default(0) @map("setup_step")
  isDemoData       Boolean               @default(false) @map("is_demo_data")
  isActive         Boolean               @default(true) @map("is_active")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int                   @default(1)

  settings            OrganizationSetting[]
  locations           BusinessLocation[]
  financialYears      FinancialYear[]
  warehouses          Warehouse[]
  users               User[]
  roles               Role[]
  documentSequences   DocumentSequence[]
  taxCategories       TaxCategory[]
  taxRates            TaxRate[]
  units               Unit[]
  auditLogs           AuditLog[]
  applicationSettings ApplicationSetting[]

  @@map("organizations")
}

/// Key/value business settings (branding, rounding, date format, ...). Typed in the service layer.
model OrganizationSetting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  value          Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("organization_settings")
}

model BusinessLocation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  addressLine1   String   @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String?
  state          String?
  stateCode      String?  @map("state_code") @db.VarChar(2)
  country        String   @default("IN") @db.VarChar(2)
  pinCode        String?  @map("pin_code") @db.VarChar(10)
  gstin          String?  @db.VarChar(15)
  isPrimary      Boolean  @default(false) @map("is_primary")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouses   Warehouse[]
  sequences    DocumentSequence[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("business_locations")
}

model FinancialYear {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Display label such as "2026-27".
  label          String
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  isLocked       Boolean   @default(false) @map("is_locked")
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sequences    DocumentSequence[]

  @@unique([organizationId, label])
  @@index([organizationId, startDate, endDate])
  @@map("financial_years")
}

model Warehouse {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid
  code           String
  name           String
  isPrimary      Boolean  @default(false) @map("is_primary")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("warehouses")
}

// ---------------------------------------------------------------------------
// Identity and access (behaviour arrives in Phase 1; tables are the foundation)
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  username           String
  displayName        String    @map("display_name")
  email              String?
  /// Argon2id hash (encoded form). Never plaintext. Never logged.
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  isDemoUser         Boolean   @default(false) @map("is_demo_user")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles        UserRole[]
  sessions     Session[]
  auditLogs    AuditLog[]

  @@unique([organizationId, username])
  @@index([organizationId])
  @@map("users")
}

model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  /// True for the five predefined role templates (spec section 11); system roles cannot be deleted.
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([organizationId, name])
  @@map("roles")
}

/// Global permission catalogue (not organization scoped): permissions are defined by the application.
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable machine key such as "sales.invoice.post".
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque session token; the token itself is never stored.
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Numbering and tax configuration
// ---------------------------------------------------------------------------

/// Transactional document-number counter. Allocation (Phase 1) must happen in the same
/// transaction that posts the document; `lastNumber` is advanced under a row lock.
model DocumentSequence {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  locationId      String?  @map("location_id") @db.Uuid
  financialYearId String   @map("financial_year_id") @db.Uuid
  documentType    String   @map("document_type")
  prefix          String   @default("")
  suffix          String   @default("")
  numericLength   Int      @default(6) @map("numeric_length")
  startNumber     BigInt   @default(1) @map("start_number")
  /// Highest number allocated so far (0 = none). Numbers are never reused.
  lastNumber      BigInt   @default(0) @map("last_number")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location      BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  financialYear FinancialYear     @relation(fields: [financialYearId], references: [id], onDelete: Restrict)

  // NOTE: PostgreSQL treats NULLs as distinct; a partial unique index in the migration
  // covers the (location IS NULL) case.
  @@unique([organizationId, locationId, financialYearId, documentType])
  @@index([organizationId])
  @@map("document_sequences")
}

model TaxCategory {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  /// STANDARD, NIL_RATED, EXEMPT, ZERO_RATED, NON_GST (classification, not a rate).
  classification String
  isActive       Boolean   @default(true) @map("is_active")
  /// Date from which the category may be used; NULL = always. Effective dating of values lives on tax_rates.
  effectiveFrom  DateTime? @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  /// USER (entered by a person) or REFERENCE_SEED (installed by the reference seed).
  origin         String    @default("USER")
  /// UNREVIEWED until an authorized accountant/tax professional has confirmed the values.
  reviewStatus   String    @default("UNREVIEWED") @map("review_status")
  reviewNote     String?   @map("review_note")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rates        TaxRate[]

  @@unique([organizationId, code])
  @@map("tax_categories")
}

/// Effective-dated tax rates. Rows are append-only in spirit: a rate change inserts a new
/// row with a new effectiveFrom and closes the old one; posted documents keep snapshots.
model TaxRate {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  /// Total GST rate in percent (e.g. 18.0000). CGST/SGST split is derived by the tax engine.
  ratePercent    Decimal   @map("rate_percent") @db.Decimal(7, 4)
  cessPercent    Decimal   @default(0) @map("cess_percent") @db.Decimal(7, 4)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  /// USER (entered by a person) or REFERENCE_SEED (installed by the reference seed).
  origin         String    @default("USER")
  /// UNREVIEWED until an authorized accountant/tax professional has confirmed the values.
  reviewStatus   String    @default("UNREVIEWED") @map("review_status")
  reviewNote     String?   @map("review_note")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     TaxCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([categoryId, effectiveFrom])
  @@index([organizationId, effectiveFrom])
  @@map("tax_rates")
}

/// Global HSN/SAC reference catalogue. Descriptions are user-maintained; no official data is bundled.
model HsnSacCode {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(8)
  /// "HSN" (goods) or "SAC" (services).
  kind        String   @db.VarChar(3)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("hsn_sac_codes")
}

model Unit {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  decimalPlaces  Int      @default(0) @map("decimal_places")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@map("units")
}

// ---------------------------------------------------------------------------
// System
// ---------------------------------------------------------------------------

/// Append-only business audit log. UPDATE and DELETE are blocked by database triggers
/// (see the foundation migration). Secrets must be redacted before insertion.
model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  userId         String?  @map("user_id") @db.Uuid
  category       String
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  beforeValues   Json?    @map("before_values")
  afterValues    Json?    @map("after_values")
  reason         String?
  appVersion     String   @map("app_version")
  deviceId       String?  @map("device_id")
  correlationId  String?  @map("correlation_id")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([entityType, entityId])
  @@index([userId, occurredAt])
  @@map("audit_logs")
}

/// Application-level settings (schema version markers, feature flags). Organization optional.
model ApplicationSetting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  value          Json
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("application_settings")
}
