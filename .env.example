# CommerceBill development environment. Copy to .env. Never commit .env.
# Values below are development placeholders only - not real credentials.

NODE_ENV=development
LOG_LEVEL=info

# API binds to loopback only (spec section 38). Non-loopback hosts are rejected by env validation.
API_HOST=127.0.0.1
API_PORT=4310

# Browser origin(s) allowed by CORS, comma-separated.
WEB_ORIGIN=http://127.0.0.1:5173

# Development/test PostgreSQL (started by `npm run db:start` using embedded-postgres,
# or by `docker compose up -d` - the Docker option is NOT required).
DATABASE_URL=postgresql://commercebill:commercebill_dev@127.0.0.1:54329/commercebill_dev?schema=public
TEST_DATABASE_ADMIN_URL=postgresql://commercebill:commercebill_dev@127.0.0.1:54329/postgres
